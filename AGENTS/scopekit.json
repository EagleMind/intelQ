{
  "project": "IntelQuery",
  "srcRoots": ["src", "src-tauri/src"],
  "modules": [
    {
      "id": "MOD-001",
      "name": "DB Connection & Query Engine",
      "globs": [
        "src/store/DbContext.tsx",
        "src/services/api.ts",
        "src/components/ConnectionsManager.tsx",
        "src-tauri/src/lib.rs",
        "src-tauri/src/main.rs"
      ],
      "deps": ["MOD-004"]
    },
    {
      "id": "MOD-002",
      "name": "Annotation System",
      "globs": [
        "src/components/annotations/**",
        "src/store/AnnotationContext.tsx",
        "src/services/annotations.ts",
        "src-tauri/src/annotations.rs"
      ],
      "deps": ["MOD-001", "MOD-004"]
    },
    {
      "id": "MOD-003",
      "name": "AI / NLQ SQL Generation",
      "globs": [
        "src/components/NLQInterface.tsx",
        "src/components/AiProviderForm.tsx",
        "src/services/llm.ts",
        "src/store/AiSettingsContext.tsx",
        "src/utils/sqlSafetyAnalyzer.ts"
      ],
      "deps": ["MOD-001", "MOD-004", "MOD-006"]
    },
    {
      "id": "MOD-004",
      "name": "App Data Store & Credentials",
      "globs": [
        "src-tauri/src/appdb.rs",
        "src/services/sync.ts"
      ],
      "deps": []
    },
    {
      "id": "MOD-005",
      "name": "Cloudflare R2 Backup",
      "globs": [
        "src-tauri/src/sync.rs",
        "src/components/SyncSettings.tsx"
      ],
      "deps": ["MOD-004"]
    },
    {
      "id": "MOD-006",
      "name": "UI Primitives & Theme",
      "globs": [
        "src/components/ui/**",
        "src/components/theme-provider.tsx",
        "src/components/theme-toggle.tsx",
        "src/index.css"
      ],
      "deps": []
    },
    {
      "id": "MOD-007",
      "name": "App Shell & Routing",
      "globs": [
        "src/App.tsx",
        "src/main.tsx",
        "src/components/DataExplorer.tsx"
      ],
      "deps": ["MOD-001", "MOD-002", "MOD-003", "MOD-004", "MOD-005", "MOD-006", "MOD-008"]
    },
    {
      "id": "MOD-008",
      "name": "Onboarding Guide",
      "globs": [
        "src/components/SetupGuide.tsx"
      ],
      "deps": ["MOD-001", "MOD-003"]
    }
  ],
  "sharedContracts": [
    "src/types/api.ts",
    "src/utils/tauri.ts",
    "src-tauri/src/lib.rs",
    "src/lib/utils.ts"
  ]
}
